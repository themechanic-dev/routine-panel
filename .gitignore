# Allowlist: everything at the top level is ignored unless it is listed here.
/*
!/.gitignore
!/README.md
!/LICENSE
!/install.sh
!/uninstall.sh
!/bin/
!/routine_panel/
!/packaging/
!/tests/
!/docs/
!/android/

# Android build output and this computer's own files
/android/.gradle/
/android/.kotlin/
/android/.idea/
/android/build/
/android/app/build/
/android/local.properties

# Never tracked, wherever they appear
__pycache__/
*.pyc
*.jks
*.keystore
*keystore.properties
*.log
.DS_Store
Thumbs.db
