<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- to offer "Open Tailscale" when the computer cannot be reached from outside the home -->
    <queries>
        <package android:name="com.tailscale.ipn" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoutinePanel"
        android:usesCleartextTraffic="true">
        <!-- Cleartext: the panel is reached at this computer's own addresses, over Tailscale (encrypted by WireGuard)
             or the home network; there is no certificate to check there. -->

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- the pairing code, when it is scanned with the phone's own camera -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="routinepanel" android:host="pair" />
            </intent-filter>
        </activity>
    </application>
</manifest>
