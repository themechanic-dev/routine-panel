#!/usr/bin/env python3
"""Starts Routine Panel from the folder it lives in. The launcher runs it with `python3 -I`, which keeps the user's
own Python settings out and also leaves this folder off the import path, so it is added here."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
sys.dont_write_bytecode = True  # no __pycache__ beside the code

from routine_panel.app import main  # noqa: E402

sys.exit(main(sys.argv[1:]))
